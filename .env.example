# Copy this file to .env and fill in the value.
#
# Get a key at https://www.last.fm/api/account/create
#
# The missing VITE_ prefix is deliberate: Vite only inlines VITE_* variables
# into the client bundle, so an unprefixed name cannot reach the browser.
# Only netlify/functions/lastfm.js reads this. Renaming it to VITE_* would
# publish the key to anyone who opens devtools.
LASTFM_API_KEY=
